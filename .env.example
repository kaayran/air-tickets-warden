# Telegram
BOT_TOKEN=
ALLOWED_USER_IDS=            # comma-separated numeric chat ids, e.g. 123456789,987654321

# Database
DATABASE_URL=postgres://warden:warden@localhost:5432/warden?sslmode=disable

# Mini App
PUBLIC_URL=                  # public HTTPS base URL of the Mini App (tunnel URL in dev)
HTTP_PORT=8080               # app server (health, SPA, /api); behind Caddy in prod

# Sources (live search)
AMADEUS_CLIENT_ID=           # required — foundation source
AMADEUS_CLIENT_SECRET=       # required
KIWI_API_KEY=                # optional, verify Tequila availability first
AVIASALES_TOKEN=             # optional, trend-only source (v1.1+)

# Rate limits (requests per second)
AMADEUS_RPS=1.0
RYANAIR_RPS=0.3
KIWI_RPS=0.5

# Daily request budgets
AMADEUS_DAILY_BUDGET=60

# Alert defaults (env-level fallbacks; overridable per user and per subscription)
COOLDOWN_HOURS=6
DROP_PCT=0.25
STABLE_PRICE_BAND_PCT=0.02
WARMUP_MIN_OBSERVATIONS=10
WARMUP_MIN_DAYS=3

# Observability
SENTRY_DSN=                  # empty = disabled
LOG_LEVEL=info
METRICS_PORT=9090

# Dev tooling — Postgres MCP (read-only, LOCAL DEV ONLY; never production)
# Used by .mcp.json to give the AI assistant read-only DB access. See docs/dev-setup.md.
WARDEN_MCP_DATABASE_URL=postgres://warden_ro:warden_ro@localhost:5432/warden?sslmode=disable
