# Telegram
# NOTE: godotenv only strips an inline `#` comment when the value before it is
# non-empty, so keys left blank here keep their comment on the line above.
BOT_TOKEN=
# comma-separated numeric chat ids, e.g. 123456789,987654321
ALLOWED_USER_IDS=

# Database
DATABASE_URL=postgres://warden:warden@localhost:5432/warden?sslmode=disable

# Mini App
# public HTTPS base URL of the Mini App (set automatically by scripts/dev.sh)
PUBLIC_URL=
HTTP_PORT=8080               # app server (health, SPA, /api); behind Caddy in prod

# Sources (live search)
# AMADEUS_* — required from Phase 2 (foundation source)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# optional, verify Tequila availability first
KIWI_API_KEY=
# optional, trend-only source (v1.1+)
AVIASALES_TOKEN=

# Rate limits (requests per second)
AMADEUS_RPS=1.0
RYANAIR_RPS=0.3
KIWI_RPS=0.5

# Daily request budgets
AMADEUS_DAILY_BUDGET=60

# Alert defaults (env-level fallbacks; overridable per user and per subscription)
COOLDOWN_HOURS=6
DROP_PCT=0.25
STABLE_PRICE_BAND_PCT=0.02
WARMUP_MIN_OBSERVATIONS=10
WARMUP_MIN_DAYS=3

# Observability
# empty = disabled (a malformed value aborts startup)
SENTRY_DSN=
LOG_LEVEL=info
METRICS_PORT=9090

# Dev tooling — read-only DB role for the AI assistant (LOCAL DEV ONLY; never production).
# Optional: only needed for host psql; the usual path is
# `docker compose exec postgres psql -U warden_ro -d warden`. See docs/dev-setup.md.
WARDEN_RO_DATABASE_URL=postgres://warden_ro:warden_ro@localhost:5432/warden?sslmode=disable
