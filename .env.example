# Telegram
# Token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to talk to the bot.
# Find your own id via @userinfobot. Example: 12345678,87654321
ALLOWED_USER_IDS=

# Database
# SQLite for MVP. Path is relative to the working directory.
DATABASE_URL=sqlite+aiosqlite:///./data/warden.db

# Web (health + metrics)
WEB_HOST=0.0.0.0
WEB_PORT=9090

# Observability
LOG_LEVEL=INFO
# false => pretty console logs (good for local dev), true => JSON (prod)
LOG_JSON=false
SENTRY_DSN=
ENVIRONMENT=dev
